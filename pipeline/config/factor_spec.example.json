{
  "name": "ocfs_residual_demo",
  "description": "预期外经营现金流入（Operating cash inflow surprise）：CFO 对自身滞后项与 Δrcv 回归后的标准化残差",
  "data": {
    "prices": "runs/demo_data/prices.pkl",
    "reports": "runs/demo_data/reports.pkl"
  },
  "formula": {
    "type": "ocfs_residual",
    "window": 8,
    "min_n": 6,
    "ddof": 3,
    "scale": "none",
    "target": "cfo_single_quarter",
    "regressors": ["cfo_lag1", "d_rcv"]
  },
  "align": {
    "mode": "ann_date",
    "note": "必须是 ann_date；用 period 对齐等于提前 2-4 个月看到财报"
  },
  "universe": {
    "exclude_financial": true,
    "min_listed_days": 250,
    "exclude_st": true
  },
  "preprocess": {
    "winsorize": true,
    "winsor_pct": [1, 99],
    "rank": true,
    "neutralize": true
  },
  "evaluate": {
    "rebalance": 21,
    "hold": 21,
    "layers": 5,
    "cost_bps": 15
  },
  "criteria": {
    "ic_min": 0.02,
    "t_min": 2.0,
    "net_positive": true,
    "note": "判据事前写死，跑完不改"
  },
  "notes": {
    "neutralize_waiver": "",
    "known_limits": "合成数据；真实数据需替换 data.prices / data.reports"
  }
}
